# Garage init job container — alpine shell + garage CLI for bucket/key setup
garage-job:
  image: {{ MINIO_JOB_DOCKER_IMAGE }}
  volumes:
    - ../../data/garage/meta:/var/lib/garage/meta:ro
    - ../plugins/minio/apps/garage/garage.toml:/etc/garage.toml:ro
  entrypoint: []
  depends_on:
    - garage
