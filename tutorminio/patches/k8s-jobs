---
apiVersion: batch/v1
kind: Job
metadata:
  name: garage-job
  labels:
    app.kubernetes.io/component: job
spec:
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: garage
          image: {{ MINIO_JOB_DOCKER_IMAGE }}
          command: []
          env:
            - name: GARAGE_RPC_SECRET
              value: "{{ MINIO_RPC_SECRET | to_hex }}"
